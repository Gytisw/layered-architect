{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "layer-l0.schema.json",
  "title": "Layer L0 Problem Framing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "layer",
    "title",
    "goals",
    "non_goals",
    "stakeholders",
    "assumptions",
    "open_questions",
    "success_criteria_draft",
    "decision_readiness"
  ],
  "properties": {
    "layer": {
      "const": "L0"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "triggered_by": {
      "type": "string"
    },
    "skip_reason": {
      "type": "string"
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "non_goals": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "stakeholders": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "needs"],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 2
          },
          "needs": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "confidence"],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 5
          },
          "confidence": {
            "enum": ["low", "medium", "high"]
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "success_criteria_draft": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "decision_readiness": {
      "enum": ["not_ready", "ready"]
    },
    "notes": {
      "type": "string"
    }
  }
}

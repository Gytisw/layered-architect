{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Layered Architect Gates",
  "type": "object",
  "required": [
    "mode",
    "question_depth",
    "l0_required",
    "l5_required",
    "research_required",
    "research_approved",
    "semantic_required",
    "semantic_completed",
    "dependencies_complete",
    "constraints_registry_present",
    "last_step",
    "research_approval_receipt",
    "research_approved_by",
    "research_approved_at",
    "semantic_completion_receipt",
    "semantic_completed_by",
    "semantic_completed_at",
    "last_validation_report"
  ],
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["strict", "soft"]
    },
    "question_depth": {
      "type": "string",
      "enum": ["minimal", "thorough"]
    },
    "l0_required": {"type": "boolean"},
    "l5_required": {"type": "boolean"},
    "research_required": {"type": "boolean"},
    "research_approved": {"type": "boolean"},
    "semantic_required": {"type": "boolean"},
    "semantic_completed": {"type": "boolean"},
    "dependencies_complete": {"type": "boolean"},
    "constraints_registry_present": {"type": "boolean"},
    "last_step": {"type": "string"},
    "research_approval_receipt": {
      "type": ["string", "null"]
    },
    "research_approved_by": {
      "type": ["string", "null"]
    },
    "research_approved_at": {
      "type": ["string", "null"]
    },
    "semantic_completion_receipt": {
      "type": ["string", "null"]
    },
    "semantic_completed_by": {
      "type": ["string", "null"]
    },
    "semantic_completed_at": {
      "type": ["string", "null"]
    },
    "last_validation_report": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": true
}

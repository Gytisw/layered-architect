{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Layered Architect Dependency Graph",
  "type": "object",
  "required": ["version", "status", "nodes", "edges"],
  "properties": {
    "version": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "complete"] },
    "nodes": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "layer": { "type": "string" },
              "description": { "type": "string" }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "type": { "type": "string" }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "acyclic": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "notes": { "type": "string" }
  },
  "additionalProperties": true
}

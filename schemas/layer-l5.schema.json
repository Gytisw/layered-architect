{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "layer-l5.schema.json",
  "title": "Layer L5 Operability and Readiness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "layer",
    "title",
    "slos",
    "observability",
    "security_controls",
    "deployment",
    "data_protection",
    "cost_guardrails",
    "readiness_checks",
    "readiness_status",
    "residual_risks"
  ],
  "properties": {
    "layer": {
      "const": "L5"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "slos": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sli", "target", "measurement"],
        "properties": {
          "name": { "type": "string", "minLength": 3 },
          "sli": { "type": "string", "minLength": 3 },
          "target": { "type": "string", "minLength": 2 },
          "measurement": { "type": "string", "minLength": 3 }
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics", "logs", "traces", "alerting"],
      "properties": {
        "metrics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 3 }
        },
        "logs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 3 }
        },
        "traces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 3 }
        },
        "alerting": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 3 }
        }
      }
    },
    "security_controls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 3 }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "rollback", "environments"],
      "properties": {
        "strategy": { "type": "string", "minLength": 3 },
        "rollback": { "type": "string", "minLength": 3 },
        "environments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "type": "string", "minLength": 2 }
        }
      }
    },
    "data_protection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backups", "retention", "rpo", "rto"],
      "properties": {
        "backups": { "type": "string", "minLength": 3 },
        "retention": { "type": "string", "minLength": 3 },
        "rpo": { "type": "string", "minLength": 2 },
        "rto": { "type": "string", "minLength": 2 }
      }
    },
    "cost_guardrails": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "type": "string", "minLength": 3 }
    },
    "runbooks": {
      "type": "array",
      "minItems": 0,
      "maxItems": 6,
      "items": { "type": "string", "minLength": 3 }
    },
    "readiness_checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 3 }
    },
    "readiness_status": {
      "enum": ["not_ready", "ready"]
    },
    "residual_risks": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 3 }
    },
    "dependencies": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 3 }
    },
    "notes": {
      "type": "string"
    }
  }
}
